@model BusinessProfile
@{ ViewData["Title"] = "Create business profile"; }
<section class="page-heading"><div class="eyebrow">BUSINESS PROFILE</div><h1>Tell us about your business</h1><p>Use accurate information. This profile is used to assess funding requirements.</p></section>
<form asp-action="Create" method="post" class="form-panel">
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <label>Business name<input asp-for="BusinessName" required /></label><span asp-validation-for="BusinessName" class="validation"></span>
    <label>Registration number<input asp-for="RegistrationNumber" /></label>
    <label>Industry<select asp-for="Industry"><option>Information Technology</option><option>Agriculture</option><option>Manufacturing</option><option>Retail</option><option>Tourism</option><option>Professional Services</option><option>Construction</option><option>Other</option></select></label>
    <label>Province<select asp-for="Province"><option>Eastern Cape</option><option>Western Cape</option><option>Gauteng</option><option>KwaZulu-Natal</option><option>Free State</option><option>Limpopo</option><option>Mpumalanga</option><option>North West</option><option>Northern Cape</option></select></label>
    <label>Annual turnover (ZAR)<input asp-for="AnnualTurnover" type="number" min="0" step="0.01" required /></label>
    <label>Years operating<input asp-for="YearsOperating" type="number" min="0" required /></label>
    <label>Funding required (ZAR)<input asp-for="FundingRequired" type="number" min="1" step="0.01" required /></label>
    <label class="wide">Business description<textarea asp-for="Description" rows="4"></textarea></label>
    <button class="button primary" type="submit">Save business profile</button>
</form>
